# OceanSentinel Phase 1 Environment Configuration

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://oceansentinel:oceansentinel@localhost:5432/oceansentinel

# Redis (Caching and Event Bus)
REDIS_URL=redis://localhost:6379/0

# Backend Server
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
LOG_LEVEL=INFO

# CORS Configuration (Frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optimization & Physics Tunables
REFERENCE_SPEED_KNOTS=15.0
FUEL_PRICE_PER_LITER=0.85
CO2_EMISSION_FACTOR=3.114
CARGO_FACTOR_COEFFICIENT=0.0005
GRID_RESOLUTION_DEG=0.5
GRID_VERSION=1.0.0
MAX_ROUTE_CANDIDATES=4
