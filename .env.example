# TRITON / OceanSentinel Phase 1 Environment Configuration

# Database (Default: SQLite for zero-config quickstart, PostgreSQL/PostGIS supported)
DATABASE_URL=sqlite:///./oceansentinel.db

# Redis (Optional caching & event bus)
REDIS_URL=redis://localhost:6379/0

# Backend Server
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
LOG_LEVEL=INFO

# CORS Configuration (Frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# CrewAI & Multi-Agent Telemetry Controls
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true
# OPENAI_API_KEY=sk-optional-key-here

# Optimization & Physics Tunables
REFERENCE_SPEED_KNOTS=15.0
FUEL_PRICE_PER_LITER=0.85
CO2_EMISSION_FACTOR=3.114
CARGO_FACTOR_COEFFICIENT=0.0005
GRID_RESOLUTION_DEG=0.5
GRID_VERSION=1.0.0
MAX_ROUTE_CANDIDATES=4

# Surveillance (Phase 3)
AIS_GAP_THRESHOLD_SECONDS=1800
RISK_ALERT_THRESHOLD=60
RISK_CASE_THRESHOLD=80
SURVEILLANCE_CYCLE_SECONDS=0

# Agents (CrewAI). Providers are tried in LLM_PROVIDER_ORDER; a provider is skipped when its key is empty.
# With no keys at all the deterministic backend still works and the agent endpoints return 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_PROVIDER_ORDER=groq,gemini,openrouter
GEMINI_MAX_RPM=10
