# OceanSentinel / TRITON Environment Configuration Example

# API Host & Server
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=production
LOG_LEVEL=INFO

# Database Configuration
# For Local Dev: sqlite:///./oceansentinel.db
# For Docker / Production: postgresql://oceansentinel:oceansentinel@db:5432/oceansentinel
DATABASE_URL=sqlite:///./oceansentinel.db

# Redis Caching & PubSub
# For Local Dev: redis://localhost:6379/0
# For Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Navigation & Physics Parameters
REFERENCE_SPEED_KNOTS=15.0
FUEL_PRICE_PER_LITER=0.85
CO2_EMISSION_FACTOR=3.114
CARGO_FACTOR_COEFFICIENT=0.0005
GRID_RESOLUTION_DEG=0.5
GRID_VERSION=1.0.0
MAX_ROUTE_CANDIDATES=4

# Surveillance & Anomaly Detection (Phase 3)
AIS_GAP_THRESHOLD_SECONDS=1800
# AIS source: simulation (default) or aisstream. A free key comes from https://aisstream.io
AIS_PROVIDER=simulation
AISSTREAM_API_KEY=
AIS_BOUNDING_BOX=10,68,16,76
AIS_COLLECT_SECONDS=30

# Sign-in (Phase 3 roles). Demo accounts; set real ones and a long random secret in production.
AUTH_USERS=admin:admin:ADMIN;operator:operator:OPERATOR;analyst:analyst:ANALYST;viewer:viewer:VIEWER
JWT_SECRET=change-me-in-production
JWT_TTL_MINUTES=480
AUTH_ALLOW_ROLE_HEADER=true
RISK_ALERT_THRESHOLD=60
RISK_CASE_THRESHOLD=80
SURVEILLANCE_CYCLE_SECONDS=60

# AI Agents & LLM Fallback (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_PROVIDER_ORDER=groq,gemini,openrouter
